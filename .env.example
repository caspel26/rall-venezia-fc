# Copy to .env (never commit .env). Names only; no real values here.

# Supabase (local CLI prints these after `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
# anon / publishable key: public by design, protected by RLS
SUPABASE_KEY=

# SERVER ONLY. Never expose to the client, never prefix with NUXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Cloudflare Access JWT validation (Stage 11)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
